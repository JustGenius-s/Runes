{
  "name": "runes-ts",
  "version": "0.1.0",
  "description": "Mark a plain TypeScript value with rune; the compiler traces its derivations and dependent calls at runtime.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "demo": "node examples/run.ts",
    "app": "vp dev src/app",
    "app:build": "vp build src/app",
    "app:preview": "vp preview src/app"
  },
  "dependencies": {
    "layerchart": "^2.5.0",
    "ts5": "npm:typescript@^5.9.2",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.45.0",
    "@svar-ui/svelte-gantt": "^2.7.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@xyflow/svelte": "^1.6.6",
    "bits-ui": "^2.19.2",
    "bumpp": "^11.1.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "shadcn-svelte": "^1.6.1",
    "svelte": "^5.57.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^5.0.0"
  },
