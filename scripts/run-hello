#!/usr/bin/env bash
set -euo pipefail

RUNES_PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RUNES_DRIVER_DIR="$RUNES_PROJECT_DIR/compiler/runes-driver"
RUNES_DRIVER_BIN="$RUNES_DRIVER_DIR/target/debug/runes-driver"
RUNES_EXAMPLE_MANIFEST="$RUNES_PROJECT_DIR/examples/hello/Cargo.toml"

(cd "$RUNES_DRIVER_DIR" && cargo build)

RUNES_LOWER_KEYWORD=1 \
RUNES_SCAN_ROOTS=1 \
RUSTC_WRAPPER="$RUNES_DRIVER_BIN" \
cargo +nightly run --manifest-path "$RUNES_EXAMPLE_MANIFEST"
